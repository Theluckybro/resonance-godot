[sub_resource type="Shader" id="Shader_l3co0"]
code = "shader_type canvas_item;\n\nuniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;\nuniform float blur_radius = 1.5;\nuniform float dim_alpha : hint_range(0.0, 1.0) = 0.4;\n\nvoid fragment() {\n\tvec2 texel = SCREEN_PIXEL_SIZE * blur_radius;\n\tvec2 uv = SCREEN_UV;\n\tvec4 blurred = vec4(0.0);\n\tblurred += textureLod(screen_texture, uv + texel * vec2(-1.0, -1.0), 0.0);\n\tblurred += textureLod(screen_texture, uv + texel * vec2(0.0, -1.0), 0.0);\n\tblurred += textureLod(screen_texture, uv + texel * vec2(1.0, -1.0), 0.0);\n\tblurred += textureLod(screen_texture, uv + texel * vec2(-1.0, 0.0), 0.0);\n\tblurred += textureLod(screen_texture, uv, 0.0);\n\tblurred += textureLod(screen_texture, uv + texel * vec2(1.0, 0.0), 0.0);\n\tblurred += textureLod(screen_texture, uv + texel * vec2(-1.0, 1.0), 0.0);\n\tblurred += textureLod(screen_texture, uv + texel * vec2(0.0, 1.0), 0.0);\n\tblurred += textureLod(screen_texture, uv + texel * vec2(1.0, 1.0), 0.0);\n\tblurred /= 9.0;\n\n\tCOLOR = vec4(blurred.rgb, dim_alpha);\n}\n"

